# Copy to .env (Windows: copy .env.example .env). Never commit .env.
# --- Supabase (leave SUPABASE_URL blank to run fully local: SQLite + local login + disk storage) ---
SUPABASE_URL=https://YOUR-REF.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_BUCKET=documents
# Supabase Postgres connection string (Connect > Session pooler), starting postgresql://
DATABASE_URL=sqlite:///./data/capitalink.db

JWT_SECRET=change-me
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:8000

# --- Payments (ZAR). sandbox = built-in checkout page. payfast = redirect to PayFast (needs API_PUBLIC_URL reachable by PayFast, e.g. a deployed backend or ngrok) ---
PAYMENT_PROVIDER=sandbox
WEBHOOK_SECRET=change-me
PAYFAST_SANDBOX=1
PAYFAST_MERCHANT_ID=10000100
PAYFAST_MERCHANT_KEY=46f0cd694581a
PAYFAST_PASSPHRASE=

# --- Gemini (free key from Google AI Studio) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Avalanche Fuji (optional) ---
AVAX_RPC=https://api.avax-test.network/ext/bc/C/rpc
RELAYER_PRIVATE_KEY=
REGISTRY_ADDRESS=
